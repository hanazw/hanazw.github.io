---
import BaseLayout from '../../layouts/base_layout.astro';
import ContactLinks from '../../components/contact_links.astro';
import { languages, local_path, type ContentLanguage } from '../../i18n/config';
import { ui } from '../../i18n/ui';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang }, props: { lang } })); }
interface Props { lang: ContentLanguage }
const { lang } = Astro.props;
const text = ui[lang];
const alternates = languages.map(language => ({ lang: language, href: local_path(language, 'about') }));
---

<BaseLayout title={`${text.about} — hana`} description={text.about_page.intro} lang={lang} section="about" alternates={alternates}>
    <section class="max-w-2xl py-12 md:py-20" aria-labelledby="about-heading">
        <h1 id="about-heading" class="text-5xl font-semibold tracking-tight sm:text-6xl">{text.about_page.title}</h1>
        <p class="mt-6 text-xl leading-relaxed">{text.about_page.intro}</p>
        {[
            { title: text.about_page.development_title, paragraphs: text.about_page.development },
            { title: text.about_page.interests_title, paragraphs: text.about_page.interests },
            { title: text.about_page.site_title, paragraphs: text.about_page.site },
        ].map(section => (
            <section class="mt-10">
                <h2 class="text-xl font-medium tracking-tight">{section.title}</h2>
                {section.paragraphs.map(paragraph => <p class="mt-4 leading-relaxed text-[var(--text-muted)]">{paragraph}</p>)}
            </section>
        ))}

        <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
            <a class="about-link arrow-link" href={local_path(lang, 'projects')}><span class="arrow-link-label">{text.projects}</span><span aria-hidden="true">↗</span></a>
            <a class="about-link arrow-link" href={local_path(lang, 'blog')}><span class="arrow-link-label">{text.blog}</span><span aria-hidden="true">↗</span></a>
            <ContactLinks lang={lang} />
        </div>
    </section>
</BaseLayout>

<style>
    .about-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 2.75rem;
        font-size: 0.875rem;
        color: var(--text-secondary);
    }
</style>
