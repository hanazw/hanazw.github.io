---
import BaseLayout from '../../layouts/base_layout.astro';
import { languages, local_path, type ContentLanguage } from '../../i18n/config';
import { ui } from '../../i18n/ui';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang }, props: { lang } })); }
interface Props { lang: ContentLanguage }
const { lang } = Astro.props;
const text = ui[lang];
const alternates = languages.map(language => ({ lang: language, href: local_path(language, 'about') }));
---

<BaseLayout title={`${text.about} — hana`} description={text.about_page.intro} lang={lang} section="about" alternates={alternates}>
    <section class="max-w-2xl py-12 md:py-20" aria-labelledby="about-heading">
        <p class="text-sm text-[var(--text-muted)]">{text.about}</p>
        <h1 id="about-heading" class="mt-4 text-5xl font-semibold tracking-tight sm:text-6xl">{text.about_page.title}</h1>
        <p class="mt-6 text-xl leading-relaxed">{text.about_page.intro}</p>
        <p class="mt-5 leading-relaxed text-[var(--text-muted)]">{text.about_page.description}</p>

        <div class="mt-12 border-t border-[var(--border-color)] pt-8">
            <h2 class="text-2xl font-semibold tracking-tight">{text.about_page.build_title}</h2>
            <p class="mt-4 leading-relaxed text-[var(--text-muted)]">{text.about_page.build}</p>
            <a class="about-link mt-4" href={`${local_path(lang)}#projects`}>{text.about_page.explore} <span aria-hidden="true">→</span></a>
        </div>

        <div class="mt-10 border-t border-[var(--border-color)] pt-8">
            <h2 class="text-2xl font-semibold tracking-tight">{text.about_page.writing_title}</h2>
            <p class="mt-4 leading-relaxed text-[var(--text-muted)]">{text.about_page.writing}</p>
            <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
                <a class="about-link" href={local_path(lang, 'blog')}>{text.blog} <span aria-hidden="true">↗</span></a>
                <a class="about-link" href={local_path(lang, 'projects')}>{text.projects} <span aria-hidden="true">↗</span></a>
                <a class="about-link" href="https://github.com/hmxsqaq">GitHub <span aria-hidden="true">↗</span></a>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .about-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 2.75rem;
        font-size: 0.875rem;
        text-decoration: underline;
        text-underline-offset: 0.25rem;
        text-decoration-color: var(--border-color);
    }

    .about-link:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 4px;
    }

    @media (hover: hover) {
        .about-link:hover {
            text-decoration-color: currentColor;
        }
    }
</style>
