---
import BaseLayout from '../../../layouts/base_layout.astro';
import { get_content_url, get_localized_entries, get_published_entries } from '../../../lib/content';
import { format_date, html_languages, language_names, languages, local_path, type ContentLanguage } from '../../../i18n/config';
import { get_tag_label } from '../../../i18n/tags';
import { ui } from '../../../i18n/ui';

export function getStaticPaths() { return languages.map(lang => ({ params: { lang }, props: { lang } })); }
interface Props { lang: ContentLanguage }
const { lang } = Astro.props;
const text = ui[lang];
const entries = get_localized_entries(await get_published_entries('blog'), lang)
  .sort((a, b) => b.data.published_date.localeCompare(a.data.published_date) || a.data.slug.localeCompare(b.data.slug));
const alternates = languages.map(language => ({ lang: language, href: local_path(language, 'blog') }));
---
<BaseLayout title={`${text.blog} — hana`} description={text.blog_intro} lang={lang} section="blog" alternates={alternates}>
  <section class="pb-16 pt-4 md:pt-10" aria-labelledby="blog-heading">
    <h1 id="blog-heading" class="text-4xl font-semibold tracking-tight sm:text-5xl">{text.blog}</h1>
    <p class="mt-4 leading-relaxed text-[var(--text-muted)]">{text.blog_intro}</p>
    <ul class="mt-7 divide-y divide-[var(--border-color)]">
      {entries.map(entry => <li data-content-id={entry.id} class="py-5">
        <a href={get_content_url(entry)} class="article-link block rounded-sm">
          <h2 lang={html_languages[entry.data.lang]} class="text-xl font-medium leading-snug">{entry.data.title}</h2>
          <p lang={html_languages[entry.data.lang]} class="mt-2 max-w-[42rem] line-clamp-2 leading-relaxed text-[var(--text-muted)]">{entry.data.description}</p>
          <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs leading-relaxed text-[var(--text-muted)]">
            <time datetime={entry.data.published_date}>{format_date(entry.data.published_date, lang)}</time>
            <span lang={html_languages[entry.data.lang]}>{language_names[entry.data.lang]}</span>
            {entry.data.tags.map(tag => <span>{get_tag_label(tag, lang)}</span>)}
          </div>
        </a>
      </li>)}
    </ul>
    {entries.length === 0 && <p class="mt-10">{text.empty}</p>}
  </section>
</BaseLayout>
<style>
  .article-link:focus-visible { outline: 2px solid currentColor; outline-offset: 6px; }
  @media (hover: hover) { .article-link:hover h2 { text-decoration: underline; text-underline-offset: .25em; } }
</style>
