---
import BaseLayout from '../../layouts/base_layout.astro';
import HeroVisual from '../../components/hero_visual.astro';
import ContactLinks from '../../components/contact_links.astro';
import { featured_projects, featured_writings, get_content_url, get_featured_entries, get_published_entries } from '../../lib/content';
import { html_languages, language_names, languages, local_path, type ContentLanguage } from '../../i18n/config';
import { get_tag_label } from '../../i18n/tags';
import { ui } from '../../i18n/ui';

export function getStaticPaths() { return languages.map(lang => ({ params: { lang }, props: { lang } })); }
interface Props { lang: ContentLanguage }
const { lang } = Astro.props;
const text = ui[lang];
const projects = get_featured_entries(await get_published_entries('projects'), featured_projects, lang);
const writings = get_featured_entries(await get_published_entries('blog'), featured_writings, lang);
const alternates = languages.map(language => ({ lang: language, href: local_path(language) }));
---

<BaseLayout title={text.home.title} description={text.home.description} lang={lang} alternates={alternates}>
	<section aria-labelledby="intro-heading" class="hero py-16 md:py-24" data-hero>
		<HeroVisual />
		<div class="hero-content">
			<p class="text-sm font-medium tracking-wide text-[var(--text-muted)]">
				{text.home.eyebrow}
			</p>
			<h1 id="intro-heading" class="mt-5 text-5xl font-semibold leading-none tracking-tight sm:text-6xl md:text-7xl">
				Zehua Wu
			</h1>
			<p class="mt-8 text-xl leading-snug tracking-tight sm:text-[1.375rem]">
				{text.home.intro}
			</p>
			<p class="mt-5 max-w-lg text-base leading-relaxed text-[var(--text-muted)] sm:text-lg">
				{text.home.description}
			</p>
			<div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
				<a
					href="#projects"
					class="hero-action arrow-link"
				>
					<span class="arrow-link-label">{text.home.view_projects}</span><span aria-hidden="true">↓</span>
				</a>
				<a href={local_path(lang, 'about')} class="hero-action arrow-link">
					<span class="arrow-link-label">{text.home.about_me}</span><span aria-hidden="true">↗</span>
				</a>
				<ContactLinks lang={lang} />
			</div>
		</div>
	</section>

	<section id="projects" aria-labelledby="projects-heading" class="scroll-mt-8 border-t border-[var(--border-color)] pt-8 pb-6 md:pb-8">
		<div class="section-heading">
			<h2 id="projects-heading" class="text-2xl font-semibold tracking-tight">{text.home.selected}</h2>
			<a class="archive-link arrow-link" href={local_path(lang, 'projects')}><span class="arrow-link-label">{text.all_projects}</span><span aria-hidden="true">↗</span></a>
		</div>

		<ul class="selected-projects mt-5">
			{projects.map((project) => (
				<li>
					<a href={get_content_url(project)} class="selected-project content-link">
						<div class:list={['selected-project-image', { 'renderer-image': project.data.slug === 'hmxs-renderer' }]}>
							{project.data.cover && <img src={project.data.cover} alt="" loading="lazy" decoding="async"/>}
						</div>
						<div class="selected-project-copy">
							<h3 lang={html_languages[project.data.lang]} class="link-title">{project.data.title}</h3>
							<p class="selected-project-meta">
								<span>{project.data.tags.map(tag => get_tag_label(tag, lang)).join(' · ')}</span>
								{project.data.lang !== lang && <span lang={html_languages[project.data.lang]}>{language_names[project.data.lang]}</span>}
							</p>
							<p lang={html_languages[project.data.lang]} class="selected-project-description">{project.data.description}</p>
						</div>
						<span class="selected-project-arrow" aria-hidden="true">↗</span>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section aria-labelledby="writing-heading" class="border-t border-[var(--border-color)] pt-6 pb-12 md:pb-14">
		<div class="section-heading">
			<h2 id="writing-heading" class="text-2xl font-semibold tracking-tight">{text.home.writing}</h2>
			<a class="archive-link arrow-link" href={local_path(lang, 'blog')}><span class="arrow-link-label">{text.all_writing}</span><span aria-hidden="true">↗</span></a>
		</div>
		<ul class="writing-list mt-5">
			{writings.map((writing) => (
				<li class="writing-item">
					<a href={get_content_url(writing)} class="writing-link content-link">
						<div>
							<h3 lang={html_languages[writing.data.lang]} class="link-title text-lg font-medium">{writing.data.title}</h3>
							<p lang={html_languages[writing.data.lang]} class="mt-2 text-sm text-[var(--text-muted)]">{writing.data.description}</p>
						</div>
						<span class="writing-language" lang={html_languages[writing.data.lang]}>{language_names[writing.data.lang]} <span aria-hidden="true">↗</span></span>
					</a>
				</li>
			))}
		</ul>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		/* 对应 main 上方的 mt-12，让背景与上下分隔线保持相同间距。 */
		margin-bottom: 3rem;
	}

	.hero-content {
		position: relative;
		z-index: 1;
		max-width: 36rem;
	}

	@media (min-width: 48rem) {
		.hero-content {
			width: 60%;
		}
	}

	.archive-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		font-size: 0.875rem;
	}

	.section-heading {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: .25rem 1.5rem;
	}

	.selected-project {
		display: grid;
		grid-template-columns: 5.5rem minmax(0, 1fr) .75rem;
		align-items: start;
		gap: .75rem;
		margin-inline: -.5rem;
		padding: 1rem .5rem;
		border-radius: .375rem;
	}

	.selected-project-image {
		position: relative;
		aspect-ratio: 8 / 5;
		overflow: hidden;
		border: 1px solid var(--border-color);
		border-radius: .375rem;
		background: #0c0c0c;
	}

	.selected-project-image img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.renderer-image img {
		position: absolute;
		bottom: 0;
		height: 150%;
		object-fit: contain;
		object-position: bottom;
	}

	.selected-project-copy {
		min-width: 0;
	}

	.selected-project-copy h3 {
		font-size: 1rem;
		line-height: 1.4;
		font-weight: 500;
		overflow-wrap: anywhere;
	}

	.selected-project-meta {
		display: flex;
		flex-wrap: wrap;
		gap: .25rem .75rem;
		margin-top: .25rem;
		font-size: .75rem;
		line-height: 1.5;
		color: var(--text-muted);
	}

	.selected-project-description {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
		margin-top: .375rem;
		font-size: .875rem;
		line-height: 1.5;
		color: var(--text-muted);
	}

	.selected-project-arrow {
		padding-top: .125rem;
		font-size: .875rem;
		color: var(--text-muted);
	}

	@media (min-width: 40rem) {
		.selected-project {
			grid-template-columns: 9rem minmax(0, 1fr) .75rem;
			align-items: center;
			column-gap: 1.5rem;
		}

		.selected-project-copy h3 {
			font-size: 1.125rem;
		}
	}

	.writing-link {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem 2rem;
		padding-block: 1.125rem;
	}

	.writing-language {
		flex-shrink: 0;
		font-size: 0.875rem;
		color: var(--text-muted);
	}

	.hero-action {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-size: 0.875rem;
		line-height: 1.25rem;
		font-weight: 500;
		color: var(--text-secondary);
	}

</style>
