---
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[]; label: string }
const { headings, label } = Astro.props;
const groups: { heading: MarkdownHeading; children: MarkdownHeading[] }[] = [];
for (const heading of headings) {
  if (heading.depth === 2) groups.push({ heading, children: [] });
  else if (heading.depth === 3) groups.at(-1)?.children.push(heading);
}
---
<aside class="article-toc">
  <details data-toc>
    <summary>{label}</summary>
    <nav aria-label={label}>
      <ol>
        {groups.map(({ heading, children }, index) => <li data-toc-section={heading.slug} data-active={index === 0 ? '' : undefined}>
          <a href={`#${heading.slug}`} data-toc-link={heading.slug} data-toc-parent={heading.slug}>{heading.text}</a>
          {children.length > 0 && <ol>
            {children.map(child => <li><a href={`#${child.slug}`} data-toc-link={child.slug} data-toc-parent={heading.slug}>{child.text}</a></li>)}
          </ol>}
        </li>)}
      </ol>
    </nav>
  </details>
</aside>
<style>
  .article-toc { min-width: 0; margin-bottom: 2rem; font-size: .8125rem; color: var(--text-muted); }
  details { padding-block: .8rem; border-block: 1px solid var(--border-color); }
  summary { cursor: pointer; color: var(--text-primary); font-weight: 500; }
  nav { margin-top: .8rem; max-height: 60vh; overflow-y: auto; scrollbar-width: thin; }
  a { display: block; padding: .35rem .25rem; line-height: 1.5; overflow-wrap: anywhere; }
  a[aria-current] { color: var(--text-primary); font-weight: 500; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: -2px; }
  li > ol { padding-left: .8rem; border-left: 1px solid var(--border-color); margin-left: .25rem; }
  li[data-toc-section]:not([data-active]) > ol { display: none; }
  @media (hover: hover) { a:hover { color: var(--text-primary); } }
  @media (min-width: 64rem) { .article-toc { grid-column: 2; grid-row: 1; position: sticky; top: 2rem; margin-bottom: 0; } details { padding-top: 0; border: none; } nav { max-height: calc(100vh - 7rem); } }
</style>
