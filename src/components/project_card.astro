---
interface Props {
    title: string;
    desc: string;
    href: string;
    category: string;
    linkLabel: string;
    lang?: string;
    languageLabel?: string;
    cover?: string;
    heading_level?: 'h2' | 'h3';
}

const { title, desc, href, category, linkLabel, lang, languageLabel, cover } = Astro.props;
const Heading = Astro.props.heading_level ?? 'h3';
---

<a href={href} class="project-card">
    {cover && <img src={cover} alt="" loading="lazy" decoding="async" class="mb-5 aspect-video w-full rounded-sm object-cover"/>}
    <p class="text-xs leading-relaxed text-[var(--text-muted)]">{category}</p>
    <Heading lang={lang} class="mt-3 text-xl font-semibold tracking-tight">{title}</Heading>
    <p lang={lang} class="mt-3 leading-relaxed text-[var(--text-muted)]">{desc}</p>
    <span class="project-link">{linkLabel}{languageLabel && ` · ${languageLabel}`} <span aria-hidden="true">→</span></span>
</a>

<style>
    .project-card {
        display: flex;
        flex-direction: column;
        padding: 1.5rem;
        border: 1px solid var(--border-color);
        border-radius: 0.75rem;
    }

    .project-link {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: auto;
        padding-top: 1.5rem;
        font-size: 0.875rem;
        font-weight: 500;
    }

    .project-card:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 4px;
    }

    @media (hover: hover) {
        .project-card:hover {
            background-color: var(--surface-hover);
        }
    }

    @media (prefers-reduced-motion: no-preference) {
        .project-card {
            transition: background-color 150ms ease;
        }
    }
</style>
