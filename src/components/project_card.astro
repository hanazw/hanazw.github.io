---
interface Props {
    title: string;
    desc: string;
    href: string;
    category: string;
    lang?: string;
    languageLabel?: string;
    cover?: string;
    cover_position?: 'center' | 'bottom';
    heading_level?: 'h2' | 'h3';
}

const { title, desc, href, category, lang, languageLabel, cover, cover_position = 'center' } = Astro.props;
const Heading = Astro.props.heading_level ?? 'h3';
---

<a href={href} class="project-card content-link">
    {cover && <div class:list={['project-media', { 'project-media-bottom': cover_position === 'bottom' }]}>
        <img src={cover} alt="" loading="lazy" decoding="async" style={{ objectPosition: cover_position }}/>
    </div>}
    <div class="project-copy">
        <p class="project-meta">
            <span>{category}</span>
            {languageLabel && <span lang={lang}>{languageLabel}</span>}
        </p>
        <Heading lang={lang} class="link-title mt-2 text-xl font-medium tracking-tight">{title}</Heading>
        <p lang={lang} class="mt-2 leading-relaxed text-[var(--text-muted)]">{desc}</p>
    </div>
</a>

<style>
    .project-card {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .project-media {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: #0c0c0c;
        border-radius: .375rem;
    }

    .project-media img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* 近方形截图保留底部模型，裁去上方调试信息。 */
    .project-media-bottom img {
        position: absolute;
        bottom: 0;
        height: 150%;
        object-fit: contain;
    }

    .project-copy {
        padding-top: .875rem;
    }

    .project-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: .25rem .75rem;
        font-size: .75rem;
        line-height: 1.5;
        color: var(--text-muted);
    }

</style>
