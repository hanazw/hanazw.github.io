---
interface Props { name: 'globe' | 'sun' | 'moon' | 'check' | 'close' | 'github' | 'mail'; size?: number }
const { name, size = 19 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'globe' && <><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></>}
  {name === 'sun' && <><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></>}
  {name === 'moon' && <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"/>}
  {name === 'check' && <path d="m5 12 4 4L19 6"/>}
  {name === 'close' && <path d="m6 6 12 12M18 6 6 18"/>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></>}
  {name === 'github' && <><path d="M9 19c-4.3 1.3-4.3-2.5-6-3m12 6v-3.9c0-1.1-.1-1.6-.5-2.1 3.3-.4 6.7-1.6 6.7-7.3a5.7 5.7 0 0 0-1.5-4c.2-.9.2-2.1-.1-3.2 0 0-1.2-.4-4 1.5a13.7 13.7 0 0 0-7.2 0c-2.8-1.9-4-1.5-4-1.5-.3 1.1-.3 2.3-.1 3.2a5.7 5.7 0 0 0-1.5 4c0 5.7 3.4 6.9 6.7 7.3-.4.5-.5 1.1-.5 2.1V22"/></>}
</svg>
