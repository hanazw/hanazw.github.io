<div class="hero-visual" aria-hidden="true">
    <canvas id="hero-visual"></canvas>
</div>

<script>
    import { initVisual } from "../scripts/hero_visual";

    const canvas = document.querySelector("#hero-visual");
    const hero = canvas?.closest("[data-hero]");

    if (canvas instanceof HTMLCanvasElement && hero instanceof HTMLElement) {
        initVisual(canvas, hero);
    }
</script>

<style>
    .hero-visual {
        position: absolute;
        inset: 0 -1.5rem;
        z-index: 0;
        pointer-events: none;
        background-color: var(--page-bg);
    }

    canvas {
        display: block;
        width: 100%;
        height: 100%;
        /* 横向淡出留在文字对齐线之外，上下仍保留 2rem 淡出。 */
        mask-image:
            linear-gradient(to right, transparent, black var(--edge-fade-x, 1rem), black calc(100% - var(--edge-fade-x, 1rem)), transparent),
            linear-gradient(to bottom, transparent, black 2rem, black calc(100% - 2rem), transparent);
        mask-composite: intersect;
    }

    @media (min-width: 70rem) {
        .hero-visual {
            inset-inline: -3rem;
            --edge-fade-x: 2rem;
        }
    }

    canvas[data-unavailable] {
        visibility: hidden;
    }
</style>
